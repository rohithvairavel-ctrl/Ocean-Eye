# Copernicus Data Space Ecosystem OAuth2 client credentials (calibrated SAR imagery).
# Create a client at https://shapps.dataspace.copernicus.eu/dashboard/ (OAuth clients).
# Sentinel-1 scene DISCOVERY works without these (public STAC catalogue); without them,
# calibrated imagery retrieval and auto-analyze report AUTH_REQUIRED. Nothing is simulated.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional: Copernicus Marine surface currents (GLOBAL_ANALYSISFORECAST_PHY_001_024).
# Requires a Copernicus Marine account AND the official toolbox:  pip install copernicusmarine
# Without both, the ocean provider reports NOT_INSTALLED / AUTH_REQUIRED.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Optional: catalogue polling interval for new watch areas, in minutes (5-1440, default 15).
# OCEANEYE_CATALOGUE_POLL_MINUTES=15

# Deployment settings. The defaults are appropriate for the local launcher.
# Set the public browser origin(s), comma separated, before using a separate frontend host.
# OCEANEYE_ALLOWED_ORIGINS=https://ocean-eye.example.org
# OCEANEYE_DEPLOYMENT_MODE=local
# OCEAN_DATA=/absolute/path/to/persistent/datasets
