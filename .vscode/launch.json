{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OCEAN-EYE: Backend debugger",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "OCEAN-EYE: Demo launcher",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ]
}
