{
  "name": "ocean-eye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write frontend vite.config.ts index.html",
    "start": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
